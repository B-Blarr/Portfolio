# Editor configuration, see https://editorconfig.org
# Applies to everything outside portfolio/, which carries its own file
# and stops the lookup there with root = true.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false
